# Configure these four values: one endpoint and key for each purpose.
# 1. Send traces, metrics, and logs to the Managed OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT="https://<your-managed-otlp-endpoint>"
# Python OTLP header parser: encode the space after ApiKey as %20.
OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey%20<ingestion-key>"

# 2. Seed and search toy instructions with one Elasticsearch API key.
# Use the Elasticsearch endpoint, not the ingest host or its /_es path.
ELASTICSEARCH_URL="https://<your-elasticsearch-endpoint>"
ELASTICSEARCH_API_KEY=""

# Demo defaults below; no changes needed.
WORKSHOP_URL=http://127.0.0.1:8001
PAINT_DELAY_SECONDS=2
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BLRP_SCHEDULE_DELAY=1000
OTEL_TRACES_SAMPLER=always_on
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=advent-demo,service.version=0.1.0
# Avoid auto ASGI/FastAPI instrumentation if you later run edot-bootstrap;
# the demo explicitly wraps both ASGI servers once.
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=fastapi,starlette,asgi
